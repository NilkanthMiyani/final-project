# ── Site identity ───────────────────────────────────────────────────────────
# Everything here has a default matching nilkanthprojects.site. A second
# deployment running from a copy of this repo overrides them rather than editing
# code, so the two stay mergeable.
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_DOMAIN=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_GITHUB_USERNAME=

# Shown on the maintenance holding page only. Everywhere else these come from
# the profile in MongoDB — but that page is served from middleware on the Edge
# runtime, where Mongoose cannot run.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# ── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string.
MONGODB_URI=

# Database within the cluster. Sites sharing a cluster MUST set different values
# here — otherwise both write the same `profile` singleton and the two
# portfolios render identical content.
MONGODB_DB=portfolio

# ── Admin (admin.<your-domain>) ─────────────────────────────────────────────
# Generate with: npm run hash-password 'your-password-here'
# Stores a scrypt `salt:hash` — never the plaintext password.
ADMIN_PASSWORD_HASH=

# Signs the admin session cookie. Generate with: openssl rand -base64 32
# Sessions also carry the site they were issued for, so a token from one admin
# is rejected by another even if this value is shared. Use a unique one anyway.
ADMIN_SESSION_SECRET=

# ── File uploads ────────────────────────────────────────────────────────────
# Vercel Blob, used for résumé uploads. Create a Blob store in the Vercel
# dashboard, then run `vercel env pull` to fetch this.
#
# A blob token grants access to the WHOLE store — it cannot be path-scoped. When
# a store is shared between sites, uploads are namespaced by domain and deletes
# are refused outside that prefix, so one site cannot remove another's files.
BLOB_READ_WRITE_TOKEN=

# ── Contact form email (optional) ───────────────────────────────────────────
# Without these, messages are still saved to the admin inbox — just not emailed.
NODEMAILER_HOST=
NODEMAILER_PORT=
NODEMAILER_USER=
NODEMAILER_PASS=
USER_MAILER=
USER_TO=

# ── Optional ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Set to 1 to serve a 503 holding page on the public hostname. The admin
# hostname and *.vercel.app previews stay reachable. Clearing it needs a
# redeploy: the Edge runtime inlines process.env at build time.
MAINTENANCE_MODE=
