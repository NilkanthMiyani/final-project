# ── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. The app always uses the `portfolio` database.
MONGODB_URI=

# ── Admin (admin.nilkanthprojects.site) ─────────────────────────────────────
# Generate with: npm run hash-password 'your-password-here'
# Stores a scrypt `salt:hash` — never the plaintext password.
ADMIN_PASSWORD_HASH=

# Signs the admin session cookie. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ── File uploads ────────────────────────────────────────────────────────────
# Vercel Blob, used for résumé uploads. Create a Blob store in the Vercel
# dashboard, then run `vercel env pull` to fetch this.
BLOB_READ_WRITE_TOKEN=

# ── Contact form email (optional) ───────────────────────────────────────────
# Without these, messages are still saved to the admin inbox — just not emailed.
NODEMAILER_HOST=
NODEMAILER_PORT=
NODEMAILER_USER=
NODEMAILER_PASS=
USER_MAILER=
USER_TO=

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nilkanthprojects.site
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
